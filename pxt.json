{
    "name": "lcd1in8",
    "version": "2.2.6",
    "description": "MakeCode extension for Waveshare 1.8 inch LCD display module",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "radio": "*",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "main.ts",
        "_locales/ja/LCD1in8-strings.json"
    ],
    "testFiles": [
        "test.ts"
    ],
    "targetVersions": {
        "target": "6.0.17",
        "targetId": "microbit"
    },
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "blocksprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "enabled": 0
                }
            }
        }
    },
    "public": true,
    "authors": [
        "Waveshare"
    ],
    "card": {
        "name": "LCD1.8",
        "imageUrl": "./static/libs/lcd1in8.png",
        "description": "A library to control Waveshare 1.8 inch LCD display",
        "cardType": "package"
    }
}
